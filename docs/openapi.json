{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ServerInfo": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "ServerInfo",
        "type": "object"
      },
      "SetupRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          },
          "public_url": {
            "maxLength": 2048,
            "title": "Public Url",
            "type": "string"
          },
          "token": {
            "maxLength": 128,
            "title": "Token",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "token",
          "username",
          "password",
          "public_url"
        ],
        "title": "SetupRequest",
        "type": "object"
      },
      "SetupStatus": {
        "properties": {
          "setup_required": {
            "title": "Setup Required",
            "type": "boolean"
          }
        },
        "required": [
          "setup_required"
        ],
        "title": "SetupStatus",
        "type": "object"
      },
      "SignedIn": {
        "properties": {
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "SignedIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Dreadovania Server"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "sign-in"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "sign-in"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "description": "Who is signed in. Returns 401 when nobody is.",
        "operationId": "current_session_api_v1_auth_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Current Session",
        "tags": [
          "sign-in"
        ]
      }
    },
    "/api/v1/info": {
      "get": {
        "description": "Server name and version.",
        "operationId": "info_api_v1_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Info",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/setup": {
      "get": {
        "description": "Whether first-run setup is still needed. Reveals nothing else.",
        "operationId": "get_setup_status_api_v1_setup_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Setup Status",
        "tags": [
          "sign-in"
        ]
      },
      "post": {
        "description": "Create the first account with the one-time setup token from the server log.",
        "operationId": "complete_setup_api_v1_setup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Complete Setup",
        "tags": [
          "sign-in"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness check for Docker and reverse proxies.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "meta"
        ]
      }
    }
  }
}
